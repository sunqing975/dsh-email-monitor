{
  "name": "dsh-email-monitor",
  "version": "0.24.0-monitor.1",
  "description": "基于 dsh-email 的 DSH 多邮箱助手：支持 QQ、163、企业邮箱等邮件接入，新增邮件监控、AI 摘要与回复建议；自动监控首期开放 163 IMAP。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/whale-fallback.png",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs",
    "assets/plugin-icon.webp"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-client.mjs",
    "prepublishOnly": "npm run build",
    "test": "node --test --test-concurrency=2 \"test/*.test.mjs\""
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "email",
    "imap",
    "smtp",
    "agentmail",
    "pop3"
  ],
  "author": "stardustlc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunqing975/dsh-email-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/sunqing975/dsh-email-monitor/issues"
  },
  "homepage": "https://github.com/sunqing975/dsh-email-monitor#readme",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3",
    "@stardustlc/dsh-updates": "0.1.4",
    "html-to-text": "10.0.1",
    "imapflow": "^2.2.1",
    "mailparser": "^3.9.33",
    "node-pop3": "0.15.3",
    "nodemailer": "^10.0.13",
    "proper-lockfile": "4.1.2",
    "schemastery": "^3.18.0",
    "socks": "^2.8.10",
    "yaml": "^2.9.0",
    "htmlparser2": "12.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.7.3"
  },
  "icon": "./assets/plugin-icon.webp"
}
